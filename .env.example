# Nurtura iOS — environment variables
# Copy to .env for local development. Do not commit .env.
#
# EAS inlines EXPO_PUBLIC_* values when the iOS binary is built.
# Set the same variables on the EAS production environment before:
#   eas build --platform ios --profile production

# Convex deployment this build should use.
# This repo has mentioned two different deployments in the past:
#   https://capable-stork-178.convex.cloud   (.env.example, July 2026)
#   https://successful-shrimp-557.convex.cloud   (former hardcoded fallback)
# Choose the deployment you intend to ship. Do not leave this blank for a release build.
EXPO_PUBLIC_CONVEX_URL=

# Public https pages. Leave blank until they exist.
# The app shows these links only when the values are https URLs.
# App Review still needs a privacy policy URL and a support URL in App Store Connect.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
